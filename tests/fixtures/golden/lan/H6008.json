{
  "description": "Conformance vectors for H6008 over lan. Every SDK — the Rust core, its bindings and any hand-written port — must produce exactly these bytes for these arguments. See ../README.md.",
  "sku": "H6008",
  "mode": "lan",
  "vectors": [
    {
      "name": "power on",
      "command": "power",
      "args": { "on": 1 },
      "message": { "msg": { "cmd": "turn", "data": { "value": 1 } } },
      "source": "captured, tests/fixtures/lan-captures/H6008/turn.json"
    },
    {
      "name": "power off",
      "command": "power",
      "args": { "on": 0 },
      "message": { "msg": { "cmd": "turn", "data": { "value": 0 } } },
      "source": "captured, tests/fixtures/lan-captures/H6008/turn.json"
    },
    {
      "name": "brightness 50%",
      "command": "brightness",
      "args": { "level": 50 },
      "message": { "msg": { "cmd": "brightness", "data": { "value": 50 } } },
      "source": "captured, tests/fixtures/lan-captures/H6008/brightness.json"
    },
    {
      "name": "brightness at the top of the range",
      "command": "brightness",
      "args": { "level": 100 },
      "message": { "msg": { "cmd": "brightness", "data": { "value": 100 } } },
      "source": "captured, tests/fixtures/lan-captures/H6008/brightness.json"
    },
    {
