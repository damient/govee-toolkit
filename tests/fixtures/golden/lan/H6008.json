  "errors": [
    {
      "name": "brightness 0 is rejected, and this firmware would have stored it",
      "command": "brightness",
      "args": { "level": 0 },
      "code": "out_of_range"
    },
    {
      "name": "brightness above 100 is rejected, and this firmware would have stored it",
      "command": "brightness",
      "args": { "level": 101 },
      "code": "out_of_range"
    },
    {
      "name": "a brightness the firmware wraps to a negative value",
      "command": "brightness",
      "args": { "level": 200 },
      "code": "out_of_range"
    },
    {
      "name": "colour temperature below the device range, which the firmware clamps to 2700",
      "command": "colortemp",
      "args": { "kelvin": 2699 },
      "code": "out_of_range"
    },
    {
      "name": "colour temperature above the device range, which the firmware clamps to 6500",
      "command": "colortemp",
      "args": { "kelvin": 6501 },
