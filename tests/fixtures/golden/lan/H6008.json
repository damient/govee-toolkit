        "msg": {
          "cmd": "colorwc",
          "data": { "color": { "r": 0, "g": 0, "b": 0 }, "colorTemInKelvin": 4000 }
        }
      },
      "source": "captured, tests/fixtures/lan-captures/H6008/colorwc.json"
    },
    {
      "name": "colour temperature at the low bound of this model",
      "command": "colortemp",
      "args": { "kelvin": 2700 },
      "message": {
        "msg": {
          "cmd": "colorwc",
          "data": { "color": { "r": 0, "g": 0, "b": 0 }, "colorTemInKelvin": 2700 }
        }
      },
      "source": "captured, tests/fixtures/lan-captures/H6008/colorwc.json"
    },
    {
      "name": "colour temperature at the high bound of this model",
      "command": "colortemp",
      "args": { "kelvin": 6500 },
      "message": {
        "msg": {
          "cmd": "colorwc",
          "data": { "color": { "r": 0, "g": 0, "b": 0 }, "colorTemInKelvin": 6500 }
        }
      },
      "source": "captured, tests/fixtures/lan-captures/H6008/colorwc.json"
    },
    {
      "name": "status request",
      "command": "status",
      "args": {},
      "message": { "msg": { "cmd": "devStatus", "data": {} } },
      "source": "captured, tests/fixtures/lan-captures/H6008/devStatus.json"
    },
    {
      "name": "undocumented raw status request",
      "command": "raw_status",
