# Local credentials for development. Copy to `.env` and fill it in:
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way — see CONTRIBUTING.md,
# "Local credentials". Run a command with it through the wrapper, from any
# directory of the repository:
#
#   tools/with-env.sh cargo run --example cloud_tour --features cloud
#
# Nothing reads this file on its own. Every package reads the environment
# variables below, so one file serves the Rust, Python and Node packages.

# The Govee cloud API key, for `cloud` mode. Request it in the Govee Home app,
# profile -> settings -> "Apply for API key". `lan` and `ble` need no key.
GOVEE_API_KEY=

# The SKU an example drives, where the example reads one.
# GOVEE_SKU=H61A0
