{
  "name": "govee-toolkit-mcp",
  "version": "0.3.1",
  "description": "Let your AI assistant take full control of your Govee lights.",
  "license": "MIT",
  "author": "damient",
  "homepage": "https://gvetk.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damient/govee-toolkit.git",
    "directory": "integrations/mcp"
  },
  "bugs": "https://github.com/damient/govee-toolkit/issues",
  "keywords": ["govee", "govee-api", "mcp", "mcp-server", "model-context-protocol", "lighting"],
  "type": "module",
  "bin": { "govee-toolkit-mcp": "dist/main.js" },
  "files": ["dist", "data"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "node scripts/copy-data.ts",
    "link:binding": "npm install --no-save ../../packages/node",
    "build": "npm run data && tsc -p tsconfig.build.json",
    "lint": "npm run lint:types && npm run lint:js",
    "lint:types": "tsc -p tsconfig.json",
    "lint:js": "oxlint --type-aware",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "govee-toolkit": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
