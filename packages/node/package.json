{
  "name": "govee-toolkit",
  "version": "0.1.0",
  "description": "Control Govee devices from your own network: undocumented LAN features, with BLE and Cloud modes when you need them.",
  "license": "MIT",
  "author": "damient",
  "homepage": "https://gvetk.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damient/govee-toolkit.git",
    "directory": "packages/node"
  },
  "bugs": "https://github.com/damient/govee-toolkit/issues",
  "keywords": ["govee", "led", "smart-home", "iot", "sdk"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "binding.cjs", "binding.d.cts"],
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "govee-toolkit",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.cjs --dts binding.d.cts && tsc -p tsconfig.json",
    "build:debug": "napi build --platform --js binding.cjs --dts binding.d.cts && tsc -p tsconfig.json",
    "build:ts": "tsc -p tsconfig.json",
    "artifacts": "napi artifacts --output-dir ./artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.3",
    "typescript": "^7.0.2"
  }
}
