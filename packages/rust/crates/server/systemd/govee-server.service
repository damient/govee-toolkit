# A systemd user service for govee-server. Install it with:
#   cp govee-server.service ~/.config/systemd/user/
#   systemctl --user enable --now govee-server
#   sudo loginctl enable-linger "$USER"    # start at boot, with no login

[Unit]
Description=Govee Toolkit Studio server
Documentation=https://github.com/damient/govee-toolkit/tree/main/packages/rust/crates/server

[Service]
# Loopback only. Switch on sharing from the Mobile page of Studio.
ExecStart=%h/.cargo/bin/govee-server
# On a machine with no screen, open the server to the network at start. The
# API has no authentication: any device on the network can control the lights.
#ExecStart=%h/.cargo/bin/govee-server --listen 0.0.0.0:4080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
