{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Govee Toolkit Studio",
  "identifier": "com.gvetk.studio",
  "build": {
    "frontendDist": "../../studio/dist",
    "beforeDevCommand": "npm --prefix ../studio run build",
    "beforeBuildCommand": "npm --prefix ../studio run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
