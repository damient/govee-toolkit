{
  "name": "govee-toolkit-site",
  "private": true,
  "version": "0.0.0",
  "description": "The govee-toolkit website, built for GitHub Pages.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "catalog": "cargo run --manifest-path ../packages/rust/Cargo.toml -p xtask -- catalog",
    "build": "node build.mjs",
    "dev": "node build.mjs --watch --serve",
    "serve": "node build.mjs --serve"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "marked": "15.0.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
